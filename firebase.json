{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "live",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        ".git/**",
        ".git",
        "**/node_modules/**",
        "package.json",
        "tests/**",
        "README.md",
        "firestore.rules",
        "firestore.indexes.json",
        "_headers",
        "_redirects",
        "testsprite_tests/**",
        "scripts/**",
        "*.md"
      ],
      "rewrites": [
        {
          "source": "/checks",
          "destination": "/checks.html"
        },
        {
          "source": "/shop/**",
          "destination": "/shop.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=(), camera=(self), microphone=()"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "preview",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        ".git/**",
        ".git",
        "**/node_modules/**",
        "package.json",
        "tests/**",
        "README.md",
        "firestore.rules",
        "firestore.indexes.json",
        "_headers",
        "_redirects",
        "testsprite_tests/**",
        "scripts/**",
        "*.md"
      ],
      "rewrites": [
        {
          "source": "/checks",
          "destination": "/checks.html"
        },
        {
          "source": "/shop/**",
          "destination": "/shop.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=(), camera=(self), microphone=()"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
